# ==============================================================================
# AegisCode Platform Environment Configuration Template
# Intelligent Developer Security, Automated Code Review & Supply Chain Guardrails
# Copy this file to .env and configure the values for your local environment.
# NEVER commit real credentials, tokens, or secret keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Security & Identity (Required)
# Both AEGIS_* (preferred) and MEISTER_* (legacy fallback) are fully supported.
# ------------------------------------------------------------------------------

# JWT signing secret — must be at least 32 characters, cryptographically random
AEGIS_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
MEISTER_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Shared authentication key between AegisCode API and auxiliary services (X-ProCursor-Key)
PROCURSOR_SHARED_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# Initial administrator account seeded on first startup (when no admin exists in the database)
AEGIS_BOOTSTRAP_ADMIN_USER=admin
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=change-me-secure-password
MEISTER_BOOTSTRAP_ADMIN_USER=admin
MEISTER_BOOTSTRAP_ADMIN_PASSWORD=change-me-secure-password

# ------------------------------------------------------------------------------
# Database Connections
# ------------------------------------------------------------------------------

# Primary PostgreSQL connection string (requires pgvector extension)
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=meisterpropr;Username=postgres;Password=devpass

# Optional dedicated auxiliary operational database connection string.
# Leave unset or set identical to DB_CONNECTION_STRING to share the same physical database instance.
PROCURSOR_DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=meisterpropr;Username=postgres;Password=devpass

# ------------------------------------------------------------------------------
# Auxiliary Service Coordination
# ------------------------------------------------------------------------------

# Remote mode: 'proprManagedRemote' (extracted service) or 'disabled'
PROCURSOR_REMOTE_MODE=proprManagedRemote

# Base URL where the AegisCode API reaches the auxiliary microservice
PROCURSOR_SERVICE_BASE_URL=http://localhost:8081

# Base URL where the auxiliary microservice reaches the AegisCode API
PROCURSOR_PROPR_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Networking, Ingress, and Security
# ------------------------------------------------------------------------------

# Allowed CORS origins (comma-separated list for cross-origin requests)
CORS_ORIGINS=http://localhost:5173

# Public API base URL as advertised to external SCM webhook senders and identity providers
AEGIS_PUBLIC_BASE_URL=http://localhost:8080/api
MEISTER_PUBLIC_BASE_URL=http://localhost:8080/api

# Directory path for persistent ASP.NET Core Data Protection key ring
# Defaults to %LOCALAPPDATA%\ASP.NET\DataProtection-Keys on Windows or ~/.aspnet/DataProtection-Keys
# AEGIS_DATA_PROTECTION_KEYS_PATH=/path/to/durable/dataprotection-keys

# Disable background hosted services during integration test runs (true/false)
# AEGIS_DISABLE_HOSTED_SERVICES=false

# ------------------------------------------------------------------------------
# Frontend Environment Configuration (Vite)
# ------------------------------------------------------------------------------

# Base URL that frontend API calls target (default: /api proxies to backend in dev)
VITE_API_BASE_URL=/api

# Allowed hostnames for Vite dev server (comma-separated)
# VITE_DEV_ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# AI Execution Limits (Optional)
# ------------------------------------------------------------------------------

# Tier-based AI iteration limits per review job
# AI_MAX_ITERATIONS_LOW=5
# AI_MAX_ITERATIONS_MEDIUM=10
# AI_MAX_ITERATIONS_HIGH=20
