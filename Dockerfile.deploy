# AegisCode production deploy image (Railway / Render / any Docker host).
#
# .NET 10 API + Node.js + gitleaks + the vulnveto security-scanning engine,
# so deterministic security scans run for real in the deployed backend.
#
# Build:  docker build -f Dockerfile.deploy -t aegiscode .
# Run:    docker run --env-file .env.deploy -p 8080:8080 aegiscode
#
# Required environment:
#   DB_CONNECTION_STRING  Npgsql connection string, e.g.
#                         Host=db;Port=5432;Database=meisterpropr;Username=postgres;Password=<redacted>
#                         The database MUST have the pgvector extension:
#                           CREATE EXTENSION IF NOT EXISTS vector;
#   MEISTER_JWT_SECRET    32+ char secret for JWT signing
#   CORS_ORIGINS          comma-separated browser origins, e.g. https://aegiscode.vercel.app
#   MEISTER_BOOTSTRAP_ADMIN_USER / MEISTER_BOOTSTRAP_ADMIN_PASSWORD
#                         seed the first admin on empty database (first boot only)
# Optional:
#   PORT                  Railway/Render inject this; defaults to 8080

# ---------- .NET API build ----------
FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS dotnet-build
WORKDIR /source
COPY Directory.Build.props .
COPY src/ src/
RUN dotnet restore src/MeisterDev.ProPR.Api/MeisterDev.ProPR.Api.csproj
RUN dotnet publish src/MeisterDev.ProPR.Api/MeisterDev.ProPR.Api.csproj \
    -c Release -o /app --no-restore

# ---------- vulnveto engine build (vendored in tools/vulnveto; no separate clone) ----------
FROM node:22-bookworm-slim AS engine-build
WORKDIR /opt/vulnveto
COPY tools/vulnveto/package.json tools/vulnveto/package-lock.json tools/vulnveto/tsconfig.json ./
COPY tools/vulnveto/src/ ./src/
RUN npm ci --no-audit --no-fund \
    && npm run build \
    && rm -rf node_modules src
# Only dist/ (built engine) + package.json (version probe) ship to runtime.

# ---------- runtime ----------
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble AS runtime

# git (safe shallow clones) + node (engine sidecar) + gitleaks (secret scan)
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

ARG GITLEAKS_VERSION=8.27.2
RUN curl -fsSL -o /tmp/gitleaks.tar.gz \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
    && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
    && rm /tmp/gitleaks.tar.gz \
    && gitleaks version

WORKDIR /app
COPY --from=dotnet-build /app .
# Published layout: the backend resolves tools/vulnveto next to its binaries
# automatically (SecurityScanningOptions.ResolveDefaultEngineDir), so no
# AEGIS_SECURITY_ENGINE_DIR override is needed. The override still exists for
# development/testing if a custom engine path is ever required.
COPY --from=engine-build /opt/vulnveto /app/tools/vulnveto

ENV AEGIS_SECURITY_GITLEAKS_BINARY=/usr/local/bin/gitleaks \
    AEGIS_SECURITY_WORK_ROOT=/tmp

EXPOSE 8080
COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
